diff --git a/src/lib/instant-preview.ts b/src/lib/instant-preview.ts
new file mode 100644
index 0000000..5fe866d
--- /dev/null
+++ b/src/lib/instant-preview.ts
@@ -0,0 +1,158 @@
+import { cookie as prismicCookie } from "@prismicio/client"
+
+export type InstantStartPreviewContext = {
+	repository: string
+	prismicHost?: string
+}
+
+export function isValidRepositoryName(label: string): boolean {
+	return /^[a-z0-9]{8}$/.test(label)
+}
+
+export function extractRepositoryFromPreviewToken(
+	previewToken: string,
+): string | undefined {
+	try {
+		const url = new URL(decodeURIComponent(previewToken))
+		const hostname = url.hostname
+		const dotIndex = hostname.indexOf(".")
+		if (dotIndex <= 0) {
+			return undefined
+		}
+
+		return hostname.slice(0, dotIndex)
+	} catch {
+		return undefined
+	}
+}
+
+function isPreviewRef(value: string): boolean {
+	return value.includes("/previews/")
+}
+
+function extractPreviewRefFromToolbarCookie(
+	value: object,
+	repositoryName?: string,
+): string | undefined {
+	for (const entry of Object.values(value)) {
+		if (
+			entry &&
+			typeof entry === "object" &&
+			"preview" in entry &&
+			typeof entry.preview === "string" &&
+			isPreviewRef(entry.preview) &&
+			(!repositoryName ||
+				previewTokenMatchesRepository(entry.preview, repositoryName))
+		) {
+			return entry.preview
+		}
+	}
+
+	return undefined
+}
+
+export function resolvePreviewTokenFromCookieValue(
+	value: string | undefined,
+	repositoryName?: string,
+): string | undefined {
+	if (!value) return undefined
+
+	// Match prismic-toolbar: try JSON first, otherwise treat as a legacy raw ref URL.
+	try {
+		const data = JSON.parse(value)
+		if (data && typeof data === "object" && !Array.isArray(data)) {
+			return extractPreviewRefFromToolbarCookie(data, repositoryName)
+		}
+	} catch {
+		// Not JSON — fall through to the legacy raw URL shape.
+	}
+
+	if (
+		isPreviewRef(value) &&
+		(!repositoryName || previewTokenMatchesRepository(value, repositoryName))
+	) {
+		return value
+	}
+
+	return undefined
+}
+
+export function extractPrismicHostFromPreviewToken(
+	previewToken: string,
+): string | undefined {
+	try {
+		const url = new URL(decodeURIComponent(previewToken))
+		const repository = extractRepositoryFromPreviewToken(previewToken)
+		if (!repository) {
+			return undefined
+		}
+
+		const cdnPrefix = `${repository}.cdn.`
+		if (url.hostname.startsWith(cdnPrefix)) {
+			const host = url.hostname.slice(cdnPrefix.length)
+			if (host === "prismic.io") {
+				return undefined
+			}
+
+			return host
+		}
+
+		const repositoryPrefix = `${repository}.`
+		if (!url.hostname.startsWith(repositoryPrefix)) {
+			return undefined
+		}
+
+		const host = url.hostname.slice(repositoryPrefix.length)
+		if (host === "prismic.io" || host === "cdn.prismic.io") {
+			return undefined
+		}
+
+		return host
+	} catch {
+		return undefined
+	}
+}
+
+export function previewTokenMatchesRepository(
+	previewToken: string,
+	repositoryName: string,
+): boolean {
+	return (
+		extractRepositoryFromPreviewToken(previewToken) === repositoryName
+	)
+}
+
+export function resolveInstantStartPreviewContextFromToken(
+	previewToken: string,
+): InstantStartPreviewContext | undefined {
+	const repository = extractRepositoryFromPreviewToken(previewToken)
+	if (!repository || !isValidRepositoryName(repository)) return undefined
+
+	return {
+		repository,
+		prismicHost: extractPrismicHostFromPreviewToken(previewToken),
+	}
+}
+
+export async function resolveInstantStartPreviewContext(): Promise<
+	InstantStartPreviewContext | undefined
+> {
+	const { cookies, draftMode } = await import("next/headers")
+
+	let isDraftModeEnabled = false
+	try {
+		isDraftModeEnabled = (await draftMode()).isEnabled
+	} catch {
+		return undefined
+	}
+
+	if (!isDraftModeEnabled) return undefined
+
+	const cookieStore = await cookies()
+	const previewToken = resolvePreviewTokenFromCookieValue(
+		cookieStore.get(prismicCookie.preview)?.value,
+	)
+	if (!previewToken) return undefined
+
+	return resolveInstantStartPreviewContextFromToken(previewToken)
+}
