index 266a841..30c8632 100644
--- a/src/prismicio.ts
+++ b/src/prismicio.ts
@@ -40,3 +40,35 @@ export const createClient = (config: ClientConfig = {}) => {
 
 	return client
 }
+
+/**
+ * Creates a Prismic client for an Instant Start hosted preview tenant.
+ */
+export const createInstantStartClient = (
+	args: { repository: string; prismicHost?: string; config?: ClientConfig },
+) => {
+	const { repository, prismicHost, config = {} } = args
+	const typedPrismicConfig = prismicConfig as PrismicConfig
+
+	const routes = typedPrismicConfig.routes.map((route) => {
+		if (route.type !== "homepage") return route
+		return { ...route, path: `/instant-preview/${repository}` }
+	},
+	)
+
+	const staticConfig: ClientConfig = { routes }
+
+	if (prismicHost) {
+		staticConfig.documentAPIEndpoint = `https://${repository}.cdn.${prismicHost}/api/v2`
+	}
+
+	const client = baseCreateClient(repository, {
+		...staticConfig,
+		fetchOptions: { cache: "no-store" },
+		...config,
+	})
+
+	enableAutoPreviews({ client })
+
+	return client
+}
