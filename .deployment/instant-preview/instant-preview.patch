+export async function createClient(config: CreateClientConfig = {}) {
+  const {
+    repository: repositoryOverride,
+    prismicHost: prismicHostOverride,
+    ...clientConfig
+  } = config;
+
+  const typedPrismicConfig = prismicConfig as PrismicConfig;
+
+  let previewContext: InstantStartPreviewContext | undefined;
+  if (repositoryOverride) {
+    previewContext = {
+      repository: repositoryOverride,
+      prismicHost: prismicHostOverride,
+    };
+  } else {
+    previewContext = await resolveInstantStartPreviewContext();
+  }
+
+  const isInstantStartPreview = Boolean(previewContext);
+  const repository = previewContext?.repository ?? repositoryName;
+
+  const staticConfig: ClientConfig = { routes: typedPrismicConfig.routes };
+  if (previewContext?.prismicHost) {
+    staticConfig.documentAPIEndpoint = `https://${repository}.cdn.${previewContext.prismicHost}/api/v2`;
+  } else if (!isInstantStartPreview && typedPrismicConfig.documentAPIEndpoint) {
+    staticConfig.documentAPIEndpoint = typedPrismicConfig.documentAPIEndpoint;
+  }
+
+  let fetchOptions: RequestInitLike;
+  if (isInstantStartPreview) {
+    fetchOptions = { cache: "no-store" };
+  } else if (process.env.NODE_ENV === "production") {
+    fetchOptions = { next: { tags: ["prismic"] }, cache: "force-cache" };
+  } else {
+    fetchOptions = { next: { revalidate: 5 } };
+  }
+
+  const client = baseCreateClient(repository, {
+    ...staticConfig,
+    fetchOptions,
+    ...clientConfig,
+  });
+
+  enableAutoPreviews({ client });
+
+  return client;
 }
