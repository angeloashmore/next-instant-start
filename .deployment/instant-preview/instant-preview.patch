@@ -0,0 +1,42 @@
+import { redirectToPreviewURL } from "@prismicio/next"
+import { NextRequest, NextResponse } from "next/server"
+
+import {
+	extractPrismicHostFromPreviewToken,
+	isValidRepositoryName,
+	previewTokenMatchesRepository,
+} from "@/lib/repository"
+import { createInstantStartClient } from "@/prismicio"
+
+type RouteParams = {
+	params: Promise<{
+		repository: string
+	}>
+}
+
+export async function GET(request: NextRequest, { params }: RouteParams) {
+	const { repository } = await params
+
+	if (!isValidRepositoryName(repository)) {
+		return new NextResponse("Repository not found", { status: 404 })
+	}
+
+	const previewToken = request.nextUrl.searchParams.get("token")
+	if (
+		previewToken &&
+		!previewTokenMatchesRepository(previewToken, repository)
+	) {
+		return new NextResponse("Preview token does not match repository", {
+			status: 403,
+		})
+	}
+
+	const prismicHost =
+		previewToken ?
+			extractPrismicHostFromPreviewToken(previewToken)
+		:	undefined
+
+	const client = createInstantStartClient({ repository, prismicHost })
+
+	return redirectToPreviewURL({ client, request })
+}
