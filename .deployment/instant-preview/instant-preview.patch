+import { redirectToPreviewURL } from "@prismicio/next";
+import { NextRequest, NextResponse } from "next/server";
+
+import {
+  extractPrismicHostFromPreviewToken,
+  isValidRepositoryName,
+  previewTokenMatchesRepository,
+} from "@/lib/instant-preview";
+import { createClient } from "@/prismicio";
+
+export async function GET(
+  request: NextRequest,
+  context: RouteContext<"/api/preview/[repository]">,
+) {
+  const { repository } = await context.params;
+
+  if (!isValidRepositoryName(repository)) {
+    return new NextResponse("Repository not found", { status: 404 });
+  }
+
+  const token = request.nextUrl.searchParams.get("token");
+  if (token && !previewTokenMatchesRepository(token, repository)) {
+    return new NextResponse("Preview token does not match repository", {
+      status: 403,
+    });
+  }
+
+  const prismicHost = token ? extractPrismicHostFromPreviewToken(token) : undefined;
+  const client = await createClient({ repository, prismicHost });
+
+  return redirectToPreviewURL({ client, request });
+}
